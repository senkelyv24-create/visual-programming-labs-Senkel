    "type": "function",
    "z": "b213000000000001",
    "name": "изменить",
    "func": "const id = Number(msg.req.params.id);\nconst body = msg.payload || {};\nif (!Number.isInteger(id) || id < 1) {\n    msg.statusCode = 400;\n    msg.payload = { error: 'Некорректный id' };\n    return msg;\n}\nif (body.title === undefined && body.author === undefined) {\n    msg.statusCode = 400;\n    msg.payload = { error: 'Нечего обновлять: укажите title или author' };\n    return msg;\n}\nif (body.title !== undefined && (typeof body.title !== 'string' || !body.title.trim())) {\n    msg.statusCode = 400;\n    msg.payload = { error: 'title должен быть непустой строкой' };\n    return msg;\n}\nif (body.author !== undefined && (typeof body.author !== 'string' || !body.author.trim())) {\n    msg.statusCode = 400;\n    msg.payload = { error: 'author должен быть непустой строкой' };\n    return msg;\n}\nlet notes = flow.get('senkelNotes') || [];\nlet found = null;\nfor (let i = 0; i < notes.length; i++) {\n    if (notes[i].id === id) {\n        if (body.title !== undefined) {\n            notes[i].title = body.title.trim();\n        }\n        if (body.author !== undefined) {\n            notes[i].author = body.author.trim();\n        }\n        found = notes[i];\n    }\n}\nif (!found) {\n    msg.statusCode = 404;\n    msg.payload = { error: 'Заметка не найдена', id: id };\n    return msg;\n}\nflow.set('senkelNotes', notes);\nmsg.statusCode = 200;\nmsg.payload = found;\nreturn msg;\n",
