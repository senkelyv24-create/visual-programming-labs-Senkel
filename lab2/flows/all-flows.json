  {
    "id": "b208000000000009",
    "type": "function",
    "z": "b208000000000001",
    "name": "элемент по id",
    "func": "const idRaw = msg.req.params.id;\nconst status = msg.req.query.status;\nconst id = Number(idRaw);\nconst allowed = ['active', 'draft'];\nconst items = [\n    { id: 1, name: 'inject-debug', owner: 'Сенкель', status: 'active' },\n    { id: 2, name: 'mqtt', owner: 'Сенкель', status: 'active' },\n    { id: 3, name: 'dashboard', owner: 'Сенкель', status: 'draft' }\n];\nif (!idRaw || !Number.isInteger(id) || id < 1) {\n    msg.statusCode = 400;\n    msg.payload = { error: 'Некорректный id', student: 'Сенкель' };\n    return msg;\n}\nif (status && allowed.indexOf(status) === -1) {\n    msg.statusCode = 400;\n    msg.payload = { error: 'Недопустимый status', allowed: allowed };\n    return msg;\n}\nlet found = null;\nfor (let i = 0; i < items.length; i++) {\n    if (items[i].id === id) {\n        if (!status || items[i].status === status) {\n            found = items[i];\n        }\n    }\n}\nif (!found) {\n    msg.statusCode = 404;\n    msg.payload = { error: 'Элемент не найден', id: id };\n    return msg;\n}\nmsg.statusCode = 200;\nmsg.payload = found;\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
