    "func": "const id = Number(msg.req.params.id);\nif (!Number.isInteger(id) || id < 1) {\n    msg.statusCode = 400;\n    msg.payload = { error: 'Некорректный id' };\n    return msg;\n}\nlet notes = flow.get('senkelNotes') || [];\nlet found = null;\nconst next = [];\nfor (let i = 0; i < notes.length; i++) {\n    if (notes[i].id === id) {\n        found = notes[i];\n    } else {\n        next.push(notes[i]);\n    }\n}\nif (!found) {\n    msg.statusCode = 404;\n    msg.payload = { error: 'Заметка не найдена', id: id };\n    return msg;\n}\nflow.set('senkelNotes', next);\nmsg.statusCode = 200;\nmsg.payload = { deleted: found };\nreturn msg;\n",
