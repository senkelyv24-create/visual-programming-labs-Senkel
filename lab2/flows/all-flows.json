    "func": "const id = Number(msg.req.params.id);\nlet notes = flow.get('senkelNotes') || [];\nif (!Number.isInteger(id) || id < 1) {\n    msg.statusCode = 400;\n    msg.payload = { error: 'id должен быть положительным целым' };\n    return msg;\n}\nlet found = null;\nfor (let i = 0; i < notes.length; i++) {\n    if (notes[i].id === id) {\n        found = notes[i];\n    }\n}\nif (!found) {\n    msg.statusCode = 404;\n    msg.payload = { error: 'Заметка не найдена', id: id };\n    return msg;\n}\nmsg.statusCode = 200;\nmsg.payload = found;\nreturn msg;\n",
