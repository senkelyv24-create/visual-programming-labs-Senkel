    "type": "function",
    "z": "b213000000000001",
    "name": "создать",
    "func": "const body = msg.payload || {};\nconst title = typeof body.title === 'string' ? body.title.trim() : '';\nconst author = typeof body.author === 'string' ? body.author.trim() : '';\nif (!title || !author) {\n    msg.statusCode = 400;\n    msg.payload = { error: 'Нужны непустые поля title и author' };\n    return msg;\n}\nlet notes = flow.get('senkelNotes');\nif (!Array.isArray(notes)) {\n    notes = [];\n}\nlet seq = flow.get('senkelNotesSeq');\nif (typeof seq !== 'number') {\n    seq = 0;\n}\nseq = seq + 1;\nconst note = { id: seq, title: title, author: author };\nnotes.push(note);\nflow.set('senkelNotes', notes);\nflow.set('senkelNotesSeq', seq);\nmsg.statusCode = 201;\nmsg.payload = note;\nreturn msg;\n",
