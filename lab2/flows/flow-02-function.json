        "name": "среднее Сенкель",
        "func": "const surname = 'Сенкель';\nlet scores = [7, 9, 6, 8, 10];\nif (Array.isArray(msg.payload) && msg.payload.length > 0) {\n    scores = msg.payload;\n}\nlet sum = 0;\nfor (let i = 0; i < scores.length; i++) {\n    sum += Number(scores[i]);\n}\nconst average = sum / scores.length;\nlet status;\nif (average >= 8) {\n    status = 'отлично';\n} else {\n    status = 'нужно подтянуть';\n}\nmsg.topic = 'lab2/senkel/function';\nmsg.payload = {\n    student: surname,\n    scores: scores,\n    average: Math.round(average * 10) / 10,\n    status: status\n};\nreturn msg;\n",
