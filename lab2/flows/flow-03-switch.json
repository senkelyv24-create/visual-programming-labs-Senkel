        "func": "const surname = 'Сенкель';\nlet scores = [9, 10, 8];\nif (Array.isArray(msg.payload) && msg.payload.length > 0) {\n    scores = msg.payload;\n}\nlet sum = 0;\nfor (let i = 0; i < scores.length; i++) {\n    sum += Number(scores[i]);\n}\nconst average = sum / scores.length;\nlet mark;\nif (average >= 8) {\n    mark = 'отлично';\n} else {\n    mark = 'нужно подтянуть';\n}\nmsg.topic = 'lab2/senkel/switch';\nmsg.student = surname;\nmsg.average = Math.round(average * 10) / 10;\nmsg.payload = mark;\nreturn msg;\n",
